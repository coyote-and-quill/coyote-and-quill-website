---
// TEMPORARY preview page for the T1 logo decision (issue #5).
// Renders all three seal variants in the nav context, two treatments each.
// DELETE this file before merging — it is not part of the public site.
import BaseLayout from '../layouts/BaseLayout.astro';

const variants = [
  { id: '01', file: '/assets/logo/cq-seal-01.svg', note: 'Dark navy seal, light-blue ring + banner ribbon wordmark' },
  { id: '02', file: '/assets/logo/cq-seal-02.svg', note: 'Light-blue solid disc — recommended (only one that pops on the dark nav)' },
  { id: '03', file: '/assets/logo/cq-seal-03.svg', note: 'Dark navy seal, light-blue ring + ribbon wordmark' },
];
---
<BaseLayout
  title="Logo preview (internal) — Coyote & Quill"
  description="Internal preview of nav logo variants. Not part of the public site."
>
  <div class="page-hero">
    <div class="container">
      <p class="label">Internal · delete before merge</p>
      <h1>Nav logo — variant &amp; treatment preview</h1>
      <p>The nav at the top of this page shows the current default (<strong>variant 02</strong>, seal + wordmark). Below: all three variants in two treatments, on the real nav background. Pick a variant and a treatment.</p>
    </div>
  </div>

  <section>
    <div class="container">
      <h2 style="margin-bottom: 8px;">Treatment A — seal + wordmark</h2>
      <p style="color: var(--slate-grey); margin-bottom: 24px;">Seal at 40px beside the text wordmark (legible name + SEO; seal reads as an emblem).</p>
      {variants.map((v) => (
        <div class="mock-wrap">
          <div class="mock-nav">
            <div class="mock-logo">
              <img src={v.file} alt="" width="40" height="40" />
              <div class="mock-text">
                <span class="mock-name">Coyote &amp; Quill</span>
                <span class="mock-desc">Advisory · Strategy · Build</span>
              </div>
            </div>
            <div class="mock-links"><span>About</span><span>Services</span><span class="mock-cta">Contact</span></div>
          </div>
          <p class="mock-cap">Variant {v.id} — {v.note}</p>
        </div>
      ))}

      <h2 style="margin: 48px 0 8px;">Treatment B — seal alone</h2>
      <p style="color: var(--slate-grey); margin-bottom: 24px;">Seal at 46px, no text wordmark (cleanest, but the name is not legible at nav size).</p>
      {variants.map((v) => (
        <div class="mock-wrap">
          <div class="mock-nav">
            <div class="mock-logo">
              <img src={v.file} alt="Coyote & Quill" width="46" height="46" />
            </div>
            <div class="mock-links"><span>About</span><span>Services</span><span class="mock-cta">Contact</span></div>
          </div>
          <p class="mock-cap">Variant {v.id}</p>
        </div>
      ))}

      <h2 style="margin: 48px 0 8px;">Size check — variant 02</h2>
      <div class="size-row">
        <span><img src="/assets/logo/cq-seal-02.svg" alt="" width="32" height="32" />32px</span>
        <span><img src="/assets/logo/cq-seal-02.svg" alt="" width="40" height="40" />40px</span>
        <span><img src="/assets/logo/cq-seal-02.svg" alt="" width="48" height="48" />48px</span>
        <span><img src="/assets/logo/cq-seal-02.svg" alt="" width="64" height="64" />64px</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .mock-wrap { margin-bottom: 20px; }
  .mock-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--night-field);
    border: 1px solid rgba(74, 96, 128, 0.25);
    border-radius: 4px;
    padding: 14px 24px;
  }
  .mock-logo { display: flex; align-items: center; gap: 12px; }
  .mock-text { display: flex; flex-direction: column; line-height: 1.1; }
  .mock-name { font-family: var(--font-display); font-style: italic; font-size: 1rem; color: var(--off-white); letter-spacing: 0.02em; }
  .mock-desc { font-size: 0.6rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--slate-grey); }
  .mock-links { display: flex; align-items: center; gap: 24px; }
  .mock-links span { font-size: 0.8rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--slate-grey); }
  .mock-cta { color: var(--coyote-orange) !important; border: 1px solid var(--coyote-orange); padding: 6px 16px; border-radius: 2px; }
  .mock-cap { color: var(--slate-grey); font-size: 0.85rem; margin: 8px 2px 0; }
  .size-row { display: flex; align-items: flex-end; gap: 32px; flex-wrap: wrap; }
  .size-row span { display: flex; flex-direction: column; align-items: center; gap: 8px; color: var(--slate-grey); font-size: 0.75rem; }
</style>
