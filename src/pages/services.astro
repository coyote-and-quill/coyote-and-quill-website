---
import BaseLayout from '../layouts/BaseLayout.astro';

const origin = (Astro.site ?? new URL('https://coyoteandquill.com')).origin;

const services = [
  {
    name: 'AI Implementation Strategy',
    url: `${origin}/services#implementation`,
    description:
      'A fixed-fee Capabilities-Based Assessment that answers honestly whether you need AI, a DOTMLPF-P readiness assessment, and full AI adoption and integration.',
  },
  {
    name: 'Vibe Coding Engagement',
    url: `${origin}/services#vibe-coding`,
    description:
      'A five-day engagement where your team ships a real, deployed internal tool with AI and installs the SMEAC briefing doctrine to keep building.',
  },
  {
    name: 'Custom App Development',
    url: `${origin}/services#app-dev`,
    description:
      'Custom web-based, AI-augmented applications built to survive production and compliance — HIPAA and FDA 21 CFR Part 11 where it counts.',
  },
];

const serviceSchemas = services.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.name,
  serviceType: s.name,
  url: s.url,
  description: s.description,
  provider: { '@id': `${origin}/#org` },
  areaServed: 'US',
}));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do I even need AI — and where do I start?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Coyote & Quill starts with a fixed-fee Capabilities-Based Assessment (CBA) that answers honestly whether AI is the right tool for the problem in front of you. If it is, the DOTMLPF-P Readiness Assessment tells you whether you are ready and exactly what to build — then we build it.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I build something real — fast, without hiring developers?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The five-day Vibe Coding Engagement has your team ship a real, deployed internal tool with AI in the room, and installs SMEAC — a briefing doctrine that lets technical and non-technical people direct AI to production-quality work after the engagement ends.',
      },
    },
    {
      '@type': 'Question',
      name: 'I need a tool built to last — and it has to survive compliance.',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Custom App Development builds web-based, AI-augmented applications with React, Next.js, and Supabase — HIPAA and FDA 21 CFR Part 11 compliant where it counts.',
      },
    },
  ],
};
---
<BaseLayout
  title="Services — Coyote & Quill"
  description="The hardest part of AI isn't the technology — it's knowing where to start. AI implementation strategy, a 5-day vibe coding engagement, and custom app development."
  jsonLd={[...serviceSchemas, faqSchema]}
>
  <div class="page-hero">
    <div class="container">
      <p class="label">Services</p>
      <h1>The hardest part of AI isn't the technology.<br />It's knowing where to start.</h1>
      <p>Most leaders are told AI will change everything — and handed no way to judge whether it changes anything for <em>their</em> business. Coyote &amp; Quill starts with the question every vendor skips: do you actually need AI for the problem in front of you? If the answer is no, we'll say so — that's the most valuable answer you can get. If it's yes, we tell you whether you're ready, exactly what to build, and then we build it.</p>
    </div>
  </div>

  <section id="implementation">
    <div class="container">
      <div class="grid-2">
        <div>
          <p class="label">Service 01</p>
          <h2>AI Implementation Strategy</h2>
          <div class="divider"></div>
          <p class="service-question">"Do I even need AI — and where do I start?"</p>
          <p>You keep hearing AI is essential. No one can tell you whether that's true for <em>your</em> process — or where it would even fit. Buy the wrong tool and you've spent the budget proving a point you could have tested for a fraction of the cost.</p>
          <p>We start with a <strong>Capabilities-Based Assessment (CBA)</strong> — a fast, fixed-fee diagnostic adapted from the military's own readiness model. It answers one question honestly: <em>is AI the right tool for this problem?</em> Sometimes it isn't — and knowing that before you spend is worth more than any deployment. If AI is the right call, the <strong>DOTMLPF-P Readiness Assessment</strong> tells you whether your organization is ready and exactly what to build. Not a score — a work order. Then we execute it: integration architecture, change management, and the training that makes it stick.</p>
          <p class="service-note">The CBA is the cheapest, fastest way to find out you <em>don't</em> need to spend $75,000. We'd rather tell you that and earn the next engagement than sell you a deployment you'll regret.</p>
        </div>
        <div>
          <div class="card">
            <h3 style="margin-bottom: 6px;">The path</h3>
            <p style="font-size: 0.85rem; color: var(--ice-blue); margin-bottom: 20px;">Start anywhere. Climb as the case is proven.</p>
            <div class="stage">
              <p class="stage-name">CBA — Capabilities-Based Assessment</p>
              <p class="stage-q">"Do you actually need AI here?"</p>
              <p class="stage-price">$2,500 – $5,000 · fixed fee</p>
            </div>
            <div class="stage">
              <p class="stage-name">DOTMLPF-P Readiness Assessment</p>
              <p class="stage-q">"Are you ready — and what do you build?"</p>
              <p class="stage-price">$5,000 – $15,000</p>
            </div>
            <div class="stage">
              <p class="stage-name">Full AI Adoption &amp; Integration</p>
              <p class="stage-q">"Build it, and make it stick."</p>
              <p class="stage-price">$15,000 – $75,000</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr style="border: none; border-top: 1px solid rgba(74,96,128,0.2);" />

  <section id="vibe-coding">
    <div class="container">
      <div class="grid-2">
        <div>
          <p class="label">Service 02</p>
          <h2>Vibe Coding Engagement</h2>
          <div class="divider"></div>
          <p class="service-question">"How do I build something real — fast, without hiring developers?"</p>
          <p>You have the ideas and the backlog. Building them means hiring developers or waiting months you don't have. AI collapsed that distance — and most teams haven't caught up to what that means.</p>
          <p>In <strong>five days</strong>, your team ships a real, deployed internal tool — and installs <strong>SMEAC</strong>, a briefing doctrine that lets technical and non-technical people direct AI to production-quality work long after we leave. Not a course. Not a sandbox demo. A tool they keep, and the discipline to build the next one.</p>
          <p class="service-note"><strong>The proof:</strong> Glen built TraceWell — a healthcare SaaS — this way, as a non-technical founder. The front-end developer he worked with was impressed enough to say so more than once — and to ask to sit down and understand how it was done.</p>
        </div>
        <div>
          <div class="card">
            <h3 style="margin-bottom: 20px;">What you leave with</h3>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 12px;">
              <li style="display: flex; gap: 12px; align-items: flex-start;">
                <span style="color: var(--coyote-orange); flex-shrink: 0; margin-top: 2px;">→</span>
                <span>A real, deployed internal tool — built by your team, in five days</span>
              </li>
              <li style="display: flex; gap: 12px; align-items: flex-start;">
                <span style="color: var(--coyote-orange); flex-shrink: 0; margin-top: 2px;">→</span>
                <span>SMEAC — a briefing doctrine for directing AI to production-quality work</span>
              </li>
              <li style="display: flex; gap: 12px; align-items: flex-start;">
                <span style="color: var(--coyote-orange); flex-shrink: 0; margin-top: 2px;">→</span>
                <span>The discipline to build the next one without us</span>
              </li>
              <li style="display: flex; gap: 12px; align-items: flex-start;">
                <span style="color: var(--coyote-orange); flex-shrink: 0; margin-top: 2px;">→</span>
                <span>Technical and non-technical people, both able to ship</span>
              </li>
            </ul>
          </div>
          <div class="card" style="margin-top: 16px;">
            <p class="label" style="margin-bottom: 4px;">Format</p>
            <p style="font-size: 1.1rem; color: var(--off-white); font-family: var(--font-display);">5-day engagement · on-site or remote</p>
            <p style="font-size: 0.8rem; color: var(--slate-grey); margin: 0 0 16px;">$6,000 – $10,000</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr style="border: none; border-top: 1px solid rgba(74,96,128,0.2);" />

  <section id="app-dev">
    <div class="container">
      <div class="grid-2">
        <div>
          <p class="label">Service 03</p>
          <h2>Custom App Development</h2>
          <div class="divider"></div>
          <p class="service-question">"I need a tool built to last — and it has to survive compliance."</p>
          <p>Off-the-shelf doesn't fit how you actually work. And advice without a built thing is just a memo that ends up in a drawer.</p>
          <p>We build the application — web-based, AI-augmented, and built to survive production <em>and</em> the auditor. React, Next.js, Supabase; HIPAA and FDA 21 CFR Part 11 where it counts; AI workflow integration that holds up under real load.</p>
          <p class="service-note"><strong>The proof:</strong> TraceWell and Fathom — the firm's own products — are the demonstration.</p>
        </div>
        <div>
          <div class="card">
            <h3 style="margin-bottom: 20px;">What we build</h3>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 12px;">
              <li style="display: flex; gap: 12px; align-items: flex-start;">
                <span style="color: var(--coyote-orange); flex-shrink: 0; margin-top: 2px;">→</span>
                <span>Web applications — React, Next.js, Supabase</span>
              </li>
              <li style="display: flex; gap: 12px; align-items: flex-start;">
                <span style="color: var(--coyote-orange); flex-shrink: 0; margin-top: 2px;">→</span>
                <span>AI-augmented internal tools and dashboards</span>
              </li>
              <li style="display: flex; gap: 12px; align-items: flex-start;">
                <span style="color: var(--coyote-orange); flex-shrink: 0; margin-top: 2px;">→</span>
                <span>Healthcare and compliance-aware applications — HIPAA, FDA 21 CFR Part 11</span>
              </li>
              <li style="display: flex; gap: 12px; align-items: flex-start;">
                <span style="color: var(--coyote-orange); flex-shrink: 0; margin-top: 2px;">→</span>
                <span>MCP server architecture and AI workflow integration</span>
              </li>
            </ul>
          </div>
          <div class="card" style="margin-top: 16px;">
            <p class="label" style="margin-bottom: 4px;">Engagement range</p>
            <p style="font-size: 1.1rem; color: var(--off-white); font-family: var(--font-display);">$10,000 – $50,000+</p>
            <p style="font-size: 0.8rem; color: var(--slate-grey); margin: 0;">By complexity and timeline</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section style="text-align: center;">
    <div class="container">
      <p class="label" style="margin-bottom: 16px;">Get Started</p>
      <h2 style="max-width: 540px; margin: 0 auto 24px;">Not sure which question is yours? Start with the cheapest answer.</h2>
      <p style="max-width: 460px; margin: 0 auto 40px; color: var(--slate-grey);">The CBA tells you whether you need any of this — for a fraction of what guessing wrong costs. Tell us the problem in front of you.</p>
      <a href="/contact" class="btn btn-primary">Start a Conversation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .service-question {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--off-white);
    margin-bottom: 16px;
  }
  .service-note {
    color: var(--ice-blue);
  }
  .stage {
    padding: 14px 0;
    border-top: 1px solid rgba(74, 96, 128, 0.2);
  }
  .stage:first-of-type {
    border-top: none;
    padding-top: 0;
  }
  .stage-name {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--off-white);
    margin-bottom: 2px;
  }
  .stage-q {
    color: var(--ice-blue);
    font-size: 0.85rem;
    margin-bottom: 4px;
  }
  .stage-price {
    color: var(--off-white);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    margin: 0;
  }
</style>
