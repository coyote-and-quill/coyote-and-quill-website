---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogType = 'website', jsonLd } = Astro.props;

// Absolute URLs for canonical + social cards (Astro.site = https://coyoteandquill.com)
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
const origin = canonical.origin;

// Sitewide entity graph — Organization + founder Person (E-E-A-T) + WebSite.
const orgGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}/#org`,
      name: 'Coyote & Quill',
      legalName: 'Coyote & Quill LLC',
      url: `${origin}/`,
      logo: `${origin}/apple-touch-icon.png`,
      image: `${origin}/og-default.png`,
      description:
        'AI implementation strategy, vibe coding engagements, and the skills and harnesses that standardize and govern how teams build — for leaders in healthcare, defense-adjacent, and regulated industries.',
      slogan: 'Observe. Assess. Advise.',
      areaServed: 'US',
      founder: { '@id': `${origin}/#glen` },
      knowsAbout: [
        'AI implementation strategy',
        'AI readiness assessment',
        'custom software development',
        'HIPAA compliance',
        'vibe coding',
      ],
    },
    {
      '@type': 'Person',
      '@id': `${origin}/#glen`,
      name: 'Glen Lewis',
      jobTitle: 'Founder',
      worksFor: { '@id': `${origin}/#org` },
      description:
        'Retired U.S. Marine Corps Lieutenant Colonel and AH-1W Cobra pilot, TTECG Coyote, and AI adoption practitioner.',
      image: `${origin}/glen-lewis.jpg`,
      knowsAbout: [
        'AI adoption',
        'AI strategy',
        'custom application development',
        'healthcare compliance',
        'vibe coding',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}/#website`,
      url: `${origin}/`,
      name: 'Coyote & Quill',
      publisher: { '@id': `${origin}/#org` },
    },
  ],
};

const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#1B1F28" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Coyote & Quill" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Structured data: sitewide Organization + founder Person + WebSite -->
  <script type="application/ld+json" set:html={JSON.stringify(orgGraph)} />
  {pageSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body>

  <a href="#main" class="skip-link">Skip to content</a>

  <nav class="site-nav" role="navigation" aria-label="Main navigation">
    <div class="nav-inner">
      <a href="/" class="nav-logo" aria-label="Coyote & Quill home">
        {/* Wordmark-led nav by design — a seal-derived disc mark reads as a muddy blob at this scale (see #25). */}
        <div class="nav-logo-text">
          <span class="nav-logo-name">Coyote &amp; Quill</span>
          <span class="nav-logo-descriptor">Advisory · Strategy · Build</span>
        </div>
      </a>
      <button class="nav-toggle" aria-expanded="false" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links" role="list">
        <li><a href="/about">About</a></li>
        <li><a href="/services">Services</a></li>
        <li><a href="/tracewell">TraceWell</a></li>
        <li><a href="/case-studies">Case Studies</a></li>
        <li><a href="/field-notes">Field Notes</a></li>
        <li><a href="/dispatches">Dispatches</a></li>
        <li><a href="/contact" class="nav-cta">Contact</a></li>
      </ul>
    </div>
  </nav>

  <main class="page-content" id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <a href="/" class="footer-brand" aria-label="Coyote & Quill home">
        <img class="footer-seal" src="/assets/logo/cq-seal-02.svg" alt="" width="120" height="120" />
      </a>
      <p class="footer-veteran">A Washington State Certified Veteran-Owned Business</p>
      <div class="footer-inner">
        <span class="footer-motto">Observe · Assess · Advise</span>
        <span class="footer-copy">&copy; 2026 <span>Coyote &amp; Quill LLC</span>. All rights reserved.</span>
      </div>
    </div>
  </footer>

  <script src="/js/main.js" is:inline></script>
  <Analytics />
</body>
</html>
