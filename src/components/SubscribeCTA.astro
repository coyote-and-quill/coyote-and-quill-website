---
// Subscribe-to-Substack CTA for the Dispatches section (issue #44).
// Renders nothing until SUBSTACK_URL is set in src/consts.ts, so no broken
// link can ship. Substack is the email/distribution channel; the website is
// canonical for the writing itself.
import { SUBSTACK_URL } from '../consts';
---
{SUBSTACK_URL && (
  <aside class="subscribe-cta">
    <p class="label">Get Dispatches by email</p>
    <p>New issues land in your inbox. The full piece always lives here first.</p>
    <a href={SUBSTACK_URL} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
      Subscribe on Substack →
    </a>
  </aside>
)}

<style>
  .subscribe-cta {
    margin: 64px auto 0;
    max-width: 720px;
    padding: 32px;
    border: 1px solid rgba(74, 96, 128, 0.3);
    border-radius: 6px;
    background: rgba(27, 58, 107, 0.15);
    text-align: center;
  }
  .subscribe-cta .label {
    margin-bottom: 12px;
    color: var(--coyote-orange);
  }
  .subscribe-cta p:not(.label) {
    color: var(--ice-blue);
    margin-bottom: 20px;
  }
</style>
